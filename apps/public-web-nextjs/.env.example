# INFO: Browser Public Web hanya berkomunikasi melalui API Gateway.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# INFO: Hanya dipakai Server Components dalam jaringan Docker Compose.
API_INTERNAL_URL=http://api-gateway:8000/api/v1

# SECURITY: Credential Portal Berita Depok hanya tersedia untuk Server Components.
# Jangan memakai awalan NEXT_PUBLIC_ dan jangan memasukkan nilai aktual ke Git.
BERITA_DEPOK_BASE_URL=
BERITA_DEPOK_API_KEY=
BERITA_DEPOK_IMAGE_HOSTS=

# INFO: Opsional sampai kontrak request "Berita bySlug" dilengkapi.
# Contoh bentuk saja; nilai aktual harus diverifikasi dari dokumentasi penyedia.
BERITA_DEPOK_DETAIL_PATH_TEMPLATE=
